<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">
        </activity>

        <!-- Launcher entries. Exactly one is enabled at a time; AppDisguisePlugin switches
             between them so the home-screen icon and name can be disguised (Premium). -->
        <activity-alias
            android:name=".LauncherDefault"
            android:targetActivity=".MainActivity"
            android:icon="@mipmap/ic_launcher"
            android:roundIcon="@mipmap/ic_launcher_round"
            android:label="@string/title_activity_main"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".LauncherCalculator"
            android:targetActivity=".MainActivity"
            android:icon="@mipmap/ic_disguise_calculator"
            android:roundIcon="@mipmap/ic_disguise_calculator"
            android:label="@string/disguise_label_calculator"
            android:enabled="false"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".LauncherNotes"
            android:targetActivity=".MainActivity"
            android:icon="@mipmap/ic_disguise_notes"
            android:roundIcon="@mipmap/ic_disguise_notes"
            android:label="@string/disguise_label_notes"
            android:enabled="false"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".LauncherWeather"
            android:targetActivity=".MainActivity"
            android:icon="@mipmap/ic_disguise_weather"
            android:roundIcon="@mipmap/ic_disguise_weather"
            android:label="@string/disguise_label_weather"
            android:enabled="false"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Permissions
         INTERNET: the relay. RECORD_AUDIO + MODIFY_AUDIO_SETTINGS: voice calls and voice
         messages (Premium); the microphone is only open during a call or a recording. ACCESS_*_LOCATION: pin drops
         (Premium), read only when the person taps "Drop a pin". USE_BIOMETRIC is merged in by the biometric
         plugin's androidx.biometric dependency (unscrambling messages). Photo attachments use the
         system picker, which needs no permission. Do not add CAMERA, storage or contacts
         without updating the privacy policy and the Play Data safety form. -->

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
</manifest>
